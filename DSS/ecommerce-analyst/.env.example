# Required once the first GA4 export exists.
GCP_PROJECT_ID=adam-test-506904
GA4_DATASET=

# Preferred for multiple sites. Copy sites.toml.example to sites.toml.
SITES_CONFIG_FILE=sites.toml
ACTIVE_SITE=connect_canada

# Optional. Defaults to the GCP project and US.
BIGQUERY_BILLING_PROJECT=
BIGQUERY_LOCATION=US
BIGQUERY_MAXIMUM_BYTES_BILLED=10000000000

# Required only to run the AI analyst (Groq).
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Intershop ICM catalog enrichment (overrides/complements sites.toml).
ICM_BASE_URL=https://connect.surewerx.com
ICM_SITE=SUREWERX-SWC_CA-Site
ICM_AUTH_MODE=anonymous
# ICM_USERNAME=
# ICM_PASSWORD=
# ICM_ORGANIZATION=
