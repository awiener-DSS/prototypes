# Copy this file to sites.toml. The real file is ignored by Git so dataset
# configuration can differ between environments.
default_site = "connect_canada"

[sites.connect_canada]
name = "SureWerx - Connect Canada"
gcp_project_id = "adam-test-506904"
ga4_dataset = ""
location = "US"
# Optional Intershop ICM catalog enrichment (anonymous token by default).
